{
  "expo": {
    "name": "KeuanganKu",
    "slug": "keuanganku-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/keuanganku-icon.png",
    "scheme": "keuanganku",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "barcodeScannerEnabled": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow KeuanganKu to photograph receipts.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-splash-screen",
      "expo-font",
      "expo-secure-store",
      "expo-background-task"
    ],
    "android": {
      "allowBackup": false,
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW"],
      "package": "com.codelora.keuanganku",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F8FAFC",
        "foregroundImage": "./assets/keuanganku-adaptive-foreground.png",
        "monochromeImage": "./assets/keuanganku-monochrome.png"
      }
    }
  }
}
